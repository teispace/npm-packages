{
  "name": "npm-packages",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=4.0.0"
  },
  "author": "Teispace",
  "license": "MIT",
  "homepage": "https://github.com/teispace/npm-packages#readme",
  "bugs": {
    "url": "https://github.com/teispace/npm-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/npm-packages.git"
  },
  "scripts": {
    "bootstrap": "yarn install",
    "build": "yarn workspaces foreach -Apt --no-private --topological run build",
    "build:packages": "yarn workspaces foreach -Apt --no-private --topological run build",
    "build:examples": "yarn workspaces foreach -Apt --include 'examples/*' run build",
    "build:all": "yarn workspaces foreach -Apt --topological run build",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --fix .",
    "clean": "rm -rf node_modules .yarn/cache .build dist **/dist coverage",
    "prepare": "husky",
    "postinstall": "husky",
    "commit": "cz",
    "type-check": "tsc --noEmit -p tsconfig.build.json && yarn workspaces foreach -Apt --no-private run type-check",
    "validate": "yarn lint && yarn type-check && yarn test && yarn build",
    "test": "yarn workspaces foreach -Apt --no-private run test",
    "test:watch": "vitest",
    "test:cov": "yarn workspaces foreach -Apt --no-private run test:cov",
    "test:ci": "yarn workspaces foreach -Apt --no-private run test:cov",
    "test:workspaces": "yarn workspaces foreach -Apt --no-private run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vitest/coverage-v8": "^5.0.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "lexical": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/code-core": "0.52.0",
    "@lexical/code-prism": "0.52.0",
    "@lexical/code-shiki": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/clipboard": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/mark": "0.52.0",
    "@lexical/hashtag": "0.52.0",
    "@lexical/overflow": "0.52.0",
    "@lexical/yjs": "0.52.0",
    "@lexical/a11y": "0.52.0",
    "@lexical/text": "0.52.0",
    "@lexical/offset": "0.52.0",
    "@lexical/file": "0.52.0",
    "@lexical/dragon": "0.52.0",
    "@lexical/devtools-core": "0.52.0"
  }
}
