{
  "name": "@teispace/teieditor",
  "version": "4.0.1",
  "description": "A powerful, fully customizable rich-text editor on Lexical: a one-line drop-in, or headless with every part replaceable.",
  "type": "module",
  "license": "MIT",
  "author": "Teispace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/npm-packages.git",
    "directory": "packages/teieditor"
  },
  "homepage": "https://github.com/teispace/npm-packages/tree/main/packages/teieditor#readme",
  "bugs": {
    "url": "https://github.com/teispace/npm-packages/issues"
  },
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "lexical",
    "react",
    "nextjs",
    "notion",
    "markdown",
    "collaboration",
    "tiptap-alternative",
    "headless",
    "shadcn"
  ],
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extensions/*": {
      "types": "./dist/extensions/*/index.d.ts",
      "import": "./dist/extensions/*/index.js",
      "default": "./dist/extensions/*/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit && tsc -p e2e",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn build",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:visual": "node e2e/visual.mjs",
    "test:types": "tsc -p type-tests/kit && tsc -p type-tests/single",
    "size": "node scripts/size-budget.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": ">=0.18.0",
    "@lexical/a11y": "^0.52.0",
    "@lexical/clipboard": "^0.52.0",
    "@lexical/code-core": "^0.52.0",
    "@lexical/code-prism": "^0.52.0",
    "@lexical/code-shiki": "^0.52.0",
    "@lexical/devtools-core": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/file": "^0.52.0",
    "@lexical/hashtag": "^0.52.0",
    "@lexical/headless": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/mark": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/overflow": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/text": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@lexical/yjs": "^0.52.0",
    "katex": ">=0.16.0",
    "lexical": "^0.52.0",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "yjs": "^13.6.0"
  },
