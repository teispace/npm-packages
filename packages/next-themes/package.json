{
  "name": "@teispace/next-themes",
  "version": "3.1.0",
  "description": "Feature-rich, lightweight theme management for Next.js and React. Zero-flash SSR, hybrid storage, view transitions, typed themes.",
  "type": "module",
  "license": "MIT",
  "author": "Teispace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/npm-packages.git",
    "directory": "packages/next-themes"
  },
  "homepage": "https://github.com/teispace/npm-packages/tree/main/packages/next-themes#readme",
  "bugs": {
    "url": "https://github.com/teispace/npm-packages/issues"
  },
  "keywords": [
    "next-themes",
    "theme",
    "dark-mode",
    "nextjs",
    "react",
    "ssr",
    "no-flash",
    "color-scheme",
    "view-transitions",
    "typescript"
  ],
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "default": "./dist/adapters.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js",
      "default": "./dist/script.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "default": "./dist/tailwind.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./codemod/from-next-themes": "./codemod/from-next-themes.cjs",
    "./hooks/use-theme": {
      "types": "./dist/hooks/use-theme.d.ts",
      "import": "./dist/hooks/use-theme.js",
      "default": "./dist/hooks/use-theme.js"
    },
    "./hooks/use-theme-value": {
      "types": "./dist/hooks/use-theme-value.d.ts",
      "import": "./dist/hooks/use-theme-value.js",
      "default": "./dist/hooks/use-theme-value.js"
    },
    "./hooks/use-theme-effect": {
      "types": "./dist/hooks/use-theme-effect.d.ts",
      "import": "./dist/hooks/use-theme-effect.js",
      "default": "./dist/hooks/use-theme-effect.js"
    },
    "./hooks/use-hydrated": {
      "types": "./dist/hooks/use-hydrated.d.ts",
      "import": "./dist/hooks/use-hydrated.js",
      "default": "./dist/hooks/use-hydrated.js"
    },
    "./components/themed-image": {
      "types": "./dist/components/themed-image.d.ts",
      "import": "./dist/components/themed-image.js",
      "default": "./dist/components/themed-image.js"
    },
    "./components/themed-icon": {
      "types": "./dist/components/themed-icon.d.ts",
      "import": "./dist/components/themed-icon.js",
      "default": "./dist/components/themed-icon.js"
    },
    "./components/scoped-theme": {
      "types": "./dist/components/scoped-theme.d.ts",
      "import": "./dist/components/scoped-theme.js",
      "default": "./dist/components/scoped-theme.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.css",
    "codemod",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn build"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jscodeshift": "^17.4.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
